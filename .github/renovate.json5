// Renovate — dependency updates for npm, the Dockerfile base images and
// GitHub Actions.
//
// A hobby app without a backend: nothing here is urgent, so updates arrive
// once a week and the routine ones are bundled. Merging a PR does not ship
// anything — the image is only built on a version tag, and the homelab stack
// pins that tag. Hence no automerge.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Third-party actions pinned to a commit SHA (version kept as a comment):
    // a tag like `@v3` can be moved to different code after the fact.
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Berlin',
  schedule: ['before 7am on monday'],
  labels: ['dependencies'],

  // Refresh package-lock.json once a month, so transitive dependencies don't
  // drift for years behind the direct ones.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 7am on the first day of the month'],
  },

  packageRules: [
    // Majors only as a checkbox in the Dependency Dashboard. Vite, Vitest and
    // Vue majors usually need code changes; a PR that cannot be merged as-is
    // is just noise.
    {
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },

    // All non-major npm updates in one PR — they are tested together anyway
    // (`npm test`, `npm run build`).
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm non-major',
    },

    // Base images in the Dockerfile: pin to a digest, so a build is
    // reproducible and `nginx:alpine` (a moving tag without a version) becomes
    // visible to Renovate at all. Digest refreshes are bundled into one PR.
    {
      matchManagers: ['dockerfile'],
      pinDigests: true,
    },
    {
      matchManagers: ['dockerfile'],
      matchUpdateTypes: ['digest', 'pin', 'pinDigest', 'minor', 'patch'],
      groupName: 'docker base images',
    },

    // GitHub Actions in one PR as well.
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },

    // Node — the build stage in the Dockerfile and `node-version` in ci.yml.
    // Matched by depName: the CI entry's packageName is `actions/node-versions`,
    // which a `matchPackageNames: ['node']` silently misses.
    //
    // Stay on LTS lines; the odd majors (25, 27 …) are never LTS. The version
    // shows up as "26", "26-alpine" or "26.13.1", so the pattern only looks at
    // the leading major. (A first attempt, /^\d*[02468]-/, matched none of the
    // candidates and froze the Dockerfile on 24 — tested in a dry run.)
    {
      matchManagers: ['dockerfile', 'github-actions'],
      matchDepNames: ['node'],
      allowedVersions: '/^v?\\d*[02468](\\D|$)/',
    },
    // …and move both together: the CI must test on the Node that builds the
    // image. In Nov 2026 the major-actions PR lifted ci.yml to 26 while the
    // Dockerfile stayed on 24. Must stay below the "github actions" rule —
    // the last matching groupName wins. Digest refreshes of the node image
    // stay with the other base images.
    {
      matchManagers: ['dockerfile', 'github-actions'],
      matchDepNames: ['node'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      groupName: 'node',
    },
  ],
}
